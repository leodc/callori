# Copy to .env. Never put credentials in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TEXT_MODEL=gpt-4.1-mini
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
TELNYX_PUBLIC_KEY=
# HTTPS tunnel to port 3001. Exposes only signed webhooks and tokenized media.
PUBLIC_BASE_URL=
# Comma-separated E.164 destinations, or * for all numbers in enabled countries (currently Japan only).
ALLOWED_PHONE_NUMBERS=
LIVE_CALLS_ENABLED=false
MAX_CALL_SECONDS=600
# Optional: shared server-only token (32+ non-whitespace characters).
# If omitted, generated locally in .callori/.
CALLORI_INTERNAL_TOKEN=
VOICE_SERVER_URL=http://127.0.0.1:3001
VOICE_PORT=3001

# Optional persistent data directory; use the same absolute path for both processes.
# CALLORI_DATA_DIR=/private/path/callori-data

# Optional business discovery. Browser-visible key: restrict by website referrer
# and to Maps JavaScript API + Places API (New); never reuse a server secret.
GOOGLE_MAPS_BROWSER_KEY=
# Optional JavaScript map ID; DEMO_MAP_ID is used for local development if blank.
GOOGLE_MAPS_MAP_ID=
