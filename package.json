{
  "name": "callori",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n voice,web \"tsx watch server/index.ts\" \"next dev --hostname 127.0.0.1\"",
    "build": "next build",
    "start": "concurrently -k -n voice,web \"tsx server/index.ts\" \"next start --hostname 127.0.0.1\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "backup": "node scripts/backup.mjs",
    "start:voice": "tsx server/index.ts",
    "start:web": "next start --hostname 127.0.0.1",
    "test:integration": "node scripts/smoke-server.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "concurrently": "10.0.5",
    "dotenv": "17.4.2",
    "libphonenumber-js": "1.13.13",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.13",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/google.maps": "3.66.2",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  }
}
